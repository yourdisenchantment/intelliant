* text=auto

# Sources and configuration
*.py    text eol=lf
*.toml  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf

# Documentation and data
*.md    text eol=lf
*.txt   text eol=lf
*.csv   text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf

# Web assets, in case a notebook exports any
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf

# Jupyter
*.ipynb text eol=lf

# Lock files: text, but not worth diffing
*.lock  text eol=lf -diff

# Binaries: leave alone
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.pkl   binary
*.npy   binary
*.npz   binary
*.pt    binary
*.pth   binary
*.bin   binary
